diff --git a/applicant_engine/scripts/validate_pilot.py b/applicant_engine/scripts/validate_pilot.py
new file mode 100644
index 0000000..976e35c
--- /dev/null
+++ b/applicant_engine/scripts/validate_pilot.py
@@ -0,0 +1,67 @@
+"""Run the synthetic document pilot: python3 -m scripts.validate_pilot."""
+import json
+import tempfile
+from pathlib import Path
+
+from admissions.core import connect, ingest, search
+from admissions.intake import stage_document, review, publish
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def validate():
+    document = ROOT / 'examples/pilot/student_application.txt'
+    expected = json.loads((ROOT / 'examples/pilot/expected.json').read_text())
+    with tempfile.TemporaryDirectory() as directory:
+        db = connect(str(Path(directory) / 'pilot.db'))
+        try:
+            staged = stage_document(db, document, 'freeform', 'pilot-001', True, 'synthetic')
+            blocked = [c for c in staged['candidates'] if c['issue']]
+            assert len(blocked) == expected['blocked_gpa_candidates']
+            assert all(c['field'] == 'gpa' for c in blocked)
+            content = db.execute('SELECT content FROM documents').fetchone()[0]
+            for candidate in staged['candidates']:
+                ev = candidate['evidence']
+                for item in ev.get('items', [ev]):
+                    assert content[item['start_char']:item['end_char']] == item['quoted_text']
+                    assert item['page'] == 1
+                review(db, candidate['id'], 'rejected' if candidate['issue'] else 'accepted', 'synthetic-pilot-review')
+            profile = publish(db, staged['batch_id'], 'pilot-snapshot', '2024-11-01')['profile']
+            for field in ('gpa', 'sat_submitted', 'interests', 'activities', 'courses'):
+                assert profile[field] == expected[field], field
+            actual_activities = [{k: a[k] for k in expected['activity_records'][0]} for a in profile['activity_records']]
+            assert actual_activities == expected['activity_records']
+            original = document.read_text()
+            essay = original.split('Personal statement:\n', 1)[1].split('\nHonors:', 1)[0]
+            assert profile['essay_draft'].strip() == essay.strip()
+            assert 'School service recognition' not in profile['essay_draft']
+            assert len(profile['activity_records']) == 3  # Essay captain anecdote is excluded.
+            assert profile['sat_submitted'] != 1490  # Negated submission is excluded.
+            assert db.execute('SELECT original_bytes FROM document_assets').fetchone()[0] == document.read_bytes()
+            ingest(db, {'schema_version': 1,
+                'sources': [{'id': 'pilot-decision-source', 'kind': 'synthetic_fixture', 'synthetic': True, 'consent': 'synthetic', 'reference': 'Fictional pilot outcome, not real admissions evidence'}],
+                'applications': [{'id': 'pilot-app', 'snapshot_id': 'pilot-snapshot', 'college_id': 'fictional-pilot-university', 'program': 'engineering', 'cycle': 2025, 'round': 'RD', 'residency': 'domestic'}],
+                'outcomes': [{'id': 'pilot-outcome', 'application_id': 'pilot-app', 'decision': 'waitlist', 'occurred_at': '2025-03-20', 'verified': False, 'source_id': 'pilot-decision-source'}]})
+            args = (db, profile, 'fictional-pilot-university', 2026, 'RD', 'engineering', 'domestic')
+            assert search(*args)['matches'] == []
+            match = search(*args, include_synthetic=True)['matches'][0]
+            assert match['score'] == 1 and match['coverage'] == .8
+            assert match['outcome_events'][0]['decision'] == 'waitlist'
+            return {'status': 'passed', 'synthetic': True, 'candidate_count': len(staged['candidates']),
+                'accepted_candidates': len(staged['candidates'])-len(blocked), 'rejected_ambiguous_gpa': len(blocked),
+                'activities_checked': len(actual_activities), 'courses_checked': len(profile['courses']),
+                'essay_matches_original_section': True, 'evidence_offsets_checked': True,
+                'original_bytes_preserved': True, 'negated_sat_excluded': True, 'essay_activity_excluded': True,
+                'publication_and_outcome_retrieval': 'passed', 'academic_similarity': match['score'],
+                'academic_coverage': match['coverage'], 'known_omissions': expected['known_omissions'],
+                'unverified': ['PDF parsing', 'OCR', 'Real embedding model inference', 'Real applicant retrieval quality'],
+                'profile': profile}
+        finally:
+            db.close()
+
+
+if __name__ == '__main__':
+    result = validate()
+    output = ROOT / 'examples/pilot/validation_result.json'
+    output.write_text(json.dumps(result, indent=2) + '\n')
+    print(json.dumps({k: v for k, v in result.items() if k != 'profile'}, indent=2))
diff --git a/applicant_engine/tests/test_core.py b/applicant_engine/tests/test_core.py
new file mode 100644
index 0000000..a4a9724
--- /dev/null
+++ b/applicant_engine/tests/test_core.py
@@ -0,0 +1,59 @@
+import unittest
+from admissions.core import connect, ingest, search, similarity
+
+
+def bundle():
+    return {'schema_version': 1,
+        'sources': [{'id': 'source', 'kind': 'demo', 'synthetic': True, 'consent': 'synthetic', 'reference': 'Generated fixture'}],
+        'snapshots': [{'id': 'snapshot', 'student_id': 'student', 'source_id': 'source', 'captured_at': '2024-10-01', 'profile': {'gpa': {'value': 3.8, 'scale': 4, 'weighted': False}, 'activities': ['robotics']}}],
+        'applications': [{'id': 'application', 'snapshot_id': 'snapshot', 'college_id': 'demo', 'program': 'engineering', 'cycle': 2025, 'round': 'RD', 'residency': 'domestic'}],
+        'outcomes': []}
+
+
+class EvidenceTests(unittest.TestCase):
+    def setUp(self):
+        self.db = connect(':memory:')
+        self.data = bundle()
+        self.query = self.data['snapshots'][0]['profile']
+
+    def tearDown(self):
+        self.db.close()
+
+    def find(self, **kwargs):
+        return search(self.db, self.query, 'demo', 2026, 'RD', 'engineering', 'domestic', **kwargs)
+
+    def test_synthetic_is_opt_in_and_missing_outcome_is_unknown(self):
+        ingest(self.db, self.data)
+        self.assertEqual(self.find()['matches'], [])
+        match = self.find(include_synthetic=True)['matches'][0]
+        self.assertEqual(match['outcome_events'], [])
+        self.assertEqual(self.find(include_synthetic=True)['category'], 'insufficient evidence')
+
+    def test_foreign_key_failure_rolls_back_import(self):
+        self.data['applications'][0]['snapshot_id'] = 'missing'
+        with self.assertRaises(Exception):
+            ingest(self.db, self.data)
+        self.assertEqual(self.db.execute('SELECT count(*) FROM sources').fetchone()[0], 0)
+
+    def test_incompatible_gpa_and_missing_fields_reduce_coverage(self):
+        candidate = {'gpa': {'value': 4.5, 'scale': 5, 'weighted': True}, 'activities': ['robotics']}
+        result = similarity(self.query, candidate)
+        self.assertEqual(result['coverage'], .15)
+        self.assertNotIn('gpa', result['components'])
+
+    def test_current_cycle_and_self_excluded(self):
+        ingest(self.db, self.data)
+        self.assertEqual(self.find(include_synthetic=True, exclude_student_id='student')['matches'], [])
+        self.assertEqual(search(self.db, self.query, 'demo', 2025, 'RD', 'engineering', 'domestic', include_synthetic=True)['matches'], [])
+
+    def test_outcome_history_preserved(self):
+        self.data['outcomes'] = [
+            {'id': 'wait', 'application_id': 'application', 'decision': 'waitlist', 'occurred_at': '2025-03-01', 'verified': False, 'source_id': 'source'},
+            {'id': 'admit', 'application_id': 'application', 'decision': 'admit', 'occurred_at': '2025-05-01', 'verified': True, 'source_id': 'source'}]
+        ingest(self.db, self.data)
+        events = self.find(include_synthetic=True)['matches'][0]['outcome_events']
+        self.assertEqual([e['decision'] for e in events], ['waitlist', 'admit'])
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/applicant_engine/tests/test_documents.py b/applicant_engine/tests/test_documents.py
new file mode 100644
index 0000000..84de341
--- /dev/null
+++ b/applicant_engine/tests/test_documents.py
@@ -0,0 +1,89 @@
+import json
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from admissions.core import connect, validate_profile
+from admissions.documents import combine_pages, extract_freeform, read_pdf
+from admissions.intake import stage_document, review, publish
+
+
+class DocumentTests(unittest.TestCase):
+    def test_freeform_to_reviewed_snapshot(self):
+        db = connect(':memory:')
+        try:
+            path = Path(__file__).resolve().parents[1] / 'examples/application.txt'
+            report = stage_document(db, path, 'freeform', 'student', True, 'synthetic')
+            values = {c['field']: c['value'] for c in report['candidates']}
+            self.assertEqual(values['gpa']['value'], 3.8)
+            self.assertEqual(values['activity_records'][0]['role'], 'Captain')
+            self.assertEqual(values['activity_records'][0]['hours_per_week'], 8)
+            self.assertEqual(values['activity_records'][1]['duration']['unit'], 'month')
+            self.assertEqual(len(values['courses']), 2)
+            self.assertEqual(values['courses'][1]['grade'], 'B+')
+            self.assertIn('Teaching a younger teammate', values['essay_draft'])
+            self.assertEqual(db.execute('SELECT original_bytes FROM document_assets').fetchone()[0], path.read_bytes())
+            for candidate in report['candidates']:
+                self.assertIsNone(candidate['issue'])
+                evidence = candidate['evidence']
+                for item in evidence.get('items', [evidence]):
+                    self.assertEqual(item['page'], 1)
+                    self.assertEqual(item['quoted_text'], (path.read_text()+'\n')[item['start_char']:item['end_char']])
+                review(db, candidate['id'], 'accepted', 'reviewer')
+            result = publish(db, report['batch_id'], 'snapshot', '2024-11-01')
+            self.assertEqual(result['profile']['courses'], values['courses'])
+        finally:
+            db.close()
+
+    def test_missing_weighting_not_inferred_and_score_not_assumed_submitted(self):
+        records = extract_freeform('My GPA is 3.8 out of 4.0. SAT score: 1450.\n')
+        self.assertEqual(len(records), 1)
+        self.assertIsNone(records[0][1])
+        self.assertIn('weighting', records[0][3])
+
+    def test_second_page_offsets(self):
+        content, pages = combine_pages([{'page': 1, 'text': 'First page', 'method': 'pdf-text'},
+                                       {'page': 2, 'text': 'Weighted GPA: 4.2 / 5.0', 'method': 'ocr'}])
+        record = extract_freeform(content, pages)[0]
+        self.assertEqual(record[2]['page'], 2)
+        self.assertEqual(record[2]['method'], 'ocr')
+        self.assertEqual(content[record[2]['start_char']:record[2]['end_char']], record[2]['quoted_text'])
+
+    def test_pdf_page_adapter_and_ocr_fallback(self):
+        class Page:
+            def __init__(self, text): self.text = text
+            def extract_text(self, **kwargs): return self.text
+        class Reader:
+            is_encrypted = False
+            def __init__(self, path): self.pages = [Page('Digital text ' * 10), Page('')]
+        with patch.dict(sys.modules, {'pypdf': types.SimpleNamespace(PdfReader=Reader)}):
+            pages = read_pdf('fixture.pdf')
+            self.assertIsNotNone(pages[1]['warning'])
+            with patch('admissions.documents.shutil.which', return_value='/tool'), patch('admissions.documents.subprocess.run') as run:
+                run.return_value = types.SimpleNamespace(stdout='OCR extracted page')
+                pages = read_pdf('fixture.pdf', ocr=True)
+                self.assertEqual(pages[0]['method'], 'pdf-text')
+                self.assertEqual(pages[1]['method'], 'ocr')
+                self.assertEqual(run.call_count, 2)
+            with patch('admissions.documents.shutil.which', return_value=None):
+                with self.assertRaises(ValueError): read_pdf('fixture.pdf', ocr=True)
+
+    def test_rich_schema_rejects_invalid_hours_and_keeps_grade_scale(self):
+        with self.assertRaises(ValueError):
+            validate_profile({'activity_records': [{'name': 'robotics', 'hours_per_week': 200}]})
+        validate_profile({'courses': [{'name': 'Math', 'grade': '87/100'}]})
+
+    def test_no_extraction_preserves_document_without_publishing(self):
+        db = connect(':memory:')
+        try:
+            with tempfile.TemporaryDirectory() as directory:
+                path = Path(directory) / 'unrecognized.txt'
+                path.write_text('Unrecognized layout retained for manual correction.')
+                report = stage_document(db, path, 'freeform', 'student', True, 'synthetic')
+            self.assertEqual(report['candidates'], [])
+            self.assertEqual(len(report['documents']), 1)
+            with self.assertRaises(ValueError): publish(db, report['batch_id'], 'snapshot', '2024-11-01')
+        finally: db.close()
diff --git a/applicant_engine/tests/test_essays.py b/applicant_engine/tests/test_essays.py
new file mode 100644
index 0000000..5973ba5
--- /dev/null
+++ b/applicant_engine/tests/test_essays.py
@@ -0,0 +1,123 @@
+import json
+import unittest
+
+from admissions.core import connect, ingest
+from admissions.essays import essay_search, index_essays
+from test_core import bundle
+
+
+class FixtureEmbedder:
+    """Known vectors test retrieval plumbing, not a substitute semantic model."""
+    key = 'test@fixed:v1'
+
+    def __init__(self):
+        self.calls = 0
+
+    def chunks(self, text):
+        return [{'start_char': 0, 'end_char': len(text), 'text': text}]
+
+    def encode(self, texts):
+        self.calls += 1
+        return [[1, 0] if t in ('I earned wages to help at home.', 'My job supported our household.') else [0, 1] for t in texts]
+
+
+class EssayTests(unittest.TestCase):
+    def setUp(self):
+        self.db = connect(':memory:')
+        self.data = bundle()
+        self.data['snapshots'][0]['profile']['essay_draft'] = 'My job supported our household.'
+        ingest(self.db, self.data)
+        self.embedder = FixtureEmbedder()
+        self.query = dict(self.data['snapshots'][0]['profile'], essay_draft='I earned wages to help at home.')
+
+    def tearDown(self):
+        self.db.close()
+
+    def find(self, **kwargs):
+        return essay_search(self.db, self.query, self.embedder, 'demo', 2026, 'RD', 'engineering', 'domestic',
+                            min_academic_coverage=.4, **kwargs)
