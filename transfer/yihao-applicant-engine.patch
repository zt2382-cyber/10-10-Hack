+"""Local PDF/OCR adapters and conservative evidence-backed text extraction."""
+import re
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+from admissions.core import require
+
+
+def read_pdf(path, ocr=False):
+    try:
+        from pypdf import PdfReader
+    except ImportError as exc:
+        raise RuntimeError('Install PDF support with: pip install -e ".[documents]"') from exc
+    path = Path(path).resolve()
+    reader = PdfReader(path)
+    require(not reader.is_encrypted, 'Decrypt the PDF before importing')
+    pages = []
+    for number, page in enumerate(reader.pages, 1):
+        text = page.extract_text(extraction_mode='layout') or ''
+        method = 'pdf-text'
+        if ocr and len(text.strip()) < 40:
+            require(shutil.which('pdftoppm') and shutil.which('tesseract'), 'OCR requires pdftoppm and tesseract installed on PATH')
+            with tempfile.TemporaryDirectory() as directory:
+                prefix = str(Path(directory) / 'page')
+                subprocess.run(['pdftoppm', '-f', str(number), '-l', str(number), '-singlefile', '-r', '200', '-png', str(path), prefix], check=True, capture_output=True, timeout=60)
+                result = subprocess.run(['tesseract', prefix+'.png', 'stdout', '-l', 'eng'], check=True, capture_output=True, text=True, timeout=60)
+                text, method = result.stdout, 'ocr'
+        pages.append({'page': number, 'text': text, 'method': method,
+                      'warning': 'Sparse page: inspect for missing scanned content' if len(text.strip()) < 40 else None})
+    require(bool(pages), 'PDF has no pages')
+    return pages
+
+
+def combine_pages(pages):
+    content, ranges = '', []
+    for page in pages:
+        start = len(content)
+        content += page['text']
+        ranges.append({**page, 'start_char': start, 'end_char': len(content)})
+        content += '\n'
+    return content, ranges
+
+
+def evidence(content, start, end, pages):
+    result = {'start_char': start, 'end_char': end, 'quoted_text': content[start:end]}
+    for page in pages:
+        if page['start_char'] <= start < page['end_char']:
+            result.update(page=page['page'], page_start_char=start-page['start_char'], method=page['method'])
+            break
+    return result
+
+
+def extract_freeform(content, pages=None):
+    """Extract only explicit assertions; unknown details remain null."""
+    pages = pages or []
+    records, activities, courses, activity_evidence, course_evidence = [], [], [], [], []
+    essay_heading = re.search(r'(?im)^\s*(?:personal statement|essay)\s*:\s*\n', content)
+    essay_span = None
+    if essay_heading:
+        next_heading = re.search(r'(?im)^\s*(?:activities|honors|education|courses|test scores)\s*:\s*$', content[essay_heading.end():])
+        essay_span = (essay_heading.end(), essay_heading.end()+next_heading.start() if next_heading else len(content))
+    # Narrative assertions in an essay are not canonical profile updates.
+    def in_essay(position):
+        return essay_span is not None and essay_span[0] <= position < essay_span[1]
+
+    # A complete GPA declaration is necessary; never infer a scale or weighting.
+    pattern = r'(?:(?P<pre>unweighted|weighted)\s+)?GPA\s*(?:is|of|:|=)?\s*(?P<value>\d+(?:\.\d+)?)\s*(?:/|out of)\s*(?P<scale>\d+(?:\.\d+)?)(?:\s*(?P<post>unweighted|weighted))?'
+    for match in re.finditer(pattern, content, re.I):
+        if in_essay(match.start()):
+            continue
+        weighting = match['pre'] or match['post']
+        ev = evidence(content, *match.span(), pages)
+        if weighting is None:
+            records.append(('gpa', None, ev, 'GPA weighting is missing; stage an explicit correction'))
+        else:
+            records.append(('gpa', {'value': float(match['value']), 'scale': float(match['scale']), 'weighted': weighting.lower() == 'weighted'}, ev, None))
+    # A raw score does not prove that it was submitted.
+    for match in re.finditer(r'\b(?:submitted\s+SAT|SAT\s+submitted)\s*(?:score|is|of|:|=)?\s*(\d{3,4})\b', content, re.I):
+        prefix = content[max(content.rfind('\n', 0, match.start())+1, match.start()-60):match.start()]
+        if in_essay(match.start()) or re.search(r'\b(?:not|never|haven.t|hasn.t|didn.t|no)\b', prefix, re.I):
+            continue
+        records.append(('sat_submitted', int(match[1]), evidence(content, *match.span(), pages), None))
+    for match in re.finditer(r'\b(?:intended major|academic interests?)\s*:\s*([^\n]+)', content, re.I):
+        if in_essay(match.start()):
+            continue
+        records.append(('interests', [x.strip().casefold() for x in match[1].split(';') if x.strip()], evidence(content, *match.span(), pages), None))
+    offset = 0
+    for line in content.splitlines(keepends=True):
+        if in_essay(offset):
+            offset += len(line)
+            continue
+        text = line.strip()
+        ev = evidence(content, offset, offset+len(line.rstrip('\r\n')), pages)
+        # Recognize labeled application/resume entries, retaining unparsed descriptions.
+        match = re.match(r'(?:activity|extracurricular)\s*:\s*([^;]+)(.*)', text, re.I)
+        narrative = re.search(r'\b(?:I am|I was|I served as)\s+(?:the\s+)?(captain|president|founder|volunteer|member)\s+(?:of|at|in)\s+([^.;\n]+)', text, re.I)
+        if match or narrative:
+            name = match[1].strip() if match else narrative[2].strip()
+            role = re.search(r'\brole\s*:\s*([^;]+)', text, re.I)
+            hours = re.search(r'(\d+(?:\.\d+)?)\s*(?:hours?|hrs?)\s*(?:/|per\s+)\s*week', text, re.I)
+            duration = re.search(r'(\d+(?:\.\d+)?)\s*(years?|months?)\b', text, re.I)
+            achievement = re.search(r'\bachievement\s*:\s*([^;]+)', text, re.I)
+            activities.append({'name': name, 'role': role[1].strip() if role else narrative[1].lower() if narrative else None,
+                'hours_per_week': float(hours[1]) if hours else None,
+                'duration': {'value': float(duration[1]), 'unit': duration[2].lower().rstrip('s')} if duration else None,
+                'achievements': [achievement[1].strip()] if achievement else [], 'description': text})
+            activity_evidence.append(ev)
+        # Recognize explicit rows; do not reinterpret grade scales.
+        match = re.match(r'course\s*:\s*([^;]+);\s*grade\s*:\s*([^;]+)(.*)', text, re.I)
+        if match:
+            tail = match[3]
+            term = re.search(r'\bterm\s*:\s*([^;]+)', tail, re.I)
+            credits = re.search(r'\bcredits\s*:\s*(\d+(?:\.\d+)?)', tail, re.I)
+            name = match[1].strip()
+            level = 'AP' if name.upper().startswith('AP ') else 'IB' if name.upper().startswith('IB ') else None
+            courses.append({'name': name, 'grade': match[2].strip(), 'term': term[1].strip() if term else None,
+                            'credits': float(credits[1]) if credits else None, 'level': level})
+            course_evidence.append(ev)
+        else:
+            # Common transcript rows: term | course | grade | credits (header excluded).
+            cells = [x.strip() for x in re.split(r'\s*\|\s*|\t+|\s{2,}', text)]
+            if len(cells) == 4 and re.fullmatch(r'(?:19|20)\d{2}(?:[- /].+)?', cells[0]) and re.fullmatch(r'[ABCDF][+-]?|\d{1,3}(?:\.\d+)?', cells[2]) and re.fullmatch(r'\d+(?:\.\d+)?', cells[3]):
+                courses.append({'term': cells[0], 'name': cells[1], 'grade': cells[2], 'credits': float(cells[3]),
+                                'level': 'AP' if cells[1].upper().startswith('AP ') else 'IB' if cells[1].upper().startswith('IB ') else None})
+                course_evidence.append(ev)
+        offset += len(line)
+    if activities:
+        records.append(('activity_records', activities, {'items': activity_evidence}, None))
+        records.append(('activities', list(dict.fromkeys(a['name'].casefold() for a in activities)), {'items': activity_evidence}, None))
+    if courses:
+        records.append(('courses', courses, {'items': course_evidence}, None))
+    # Explicit essay headings delimit a contiguous essay section.
+    match = re.search(r'(?im)^\s*(?:personal statement|essay)\s*:\s*\n', content)
+    if match:
+        end_match = re.search(r'(?im)^\s*(?:activities|honors|education|courses|test scores)\s*:\s*$', content[match.end():])
+        end = match.end()+end_match.start() if end_match else len(content)
+        if content[match.end():end].strip():
+            records.append(('essay_draft', content[match.end():end], evidence(content, match.end(), end, pages), None))
+    return records
diff --git a/applicant_engine/admissions/essays.py b/applicant_engine/admissions/essays.py
new file mode 100644
index 0000000..b7cc34f
--- /dev/null
+++ b/applicant_engine/admissions/essays.py
@@ -0,0 +1,158 @@
+"""Local semantic essay retrieval. Scores describe content, not admission chances."""
+import hashlib
+import json
+import math
+
+from admissions.core import require, search
+
+DEFAULT_MODEL = 'sentence-transformers/all-MiniLM-L6-v2'
+INDEX_SCHEMA = '''
+CREATE TABLE IF NOT EXISTS essay_embeddings (
+ snapshot_id TEXT NOT NULL REFERENCES snapshots(id),
+ model_key TEXT NOT NULL, text_hash TEXT NOT NULL,
+ chunks_json TEXT NOT NULL, vectors_json TEXT NOT NULL,
+ PRIMARY KEY (snapshot_id, model_key)
+);
+'''
+
+
+class LocalEmbedder:
+    def __init__(self, model=DEFAULT_MODEL, revision=None):
+        try:
+            from sentence_transformers import SentenceTransformer
+        except ImportError as exc:
+            raise RuntimeError('Install essay dependencies: pip install -e ".[essays]"') from exc
+        self.model = SentenceTransformer(model, revision=revision, trust_remote_code=False)
+        resolved = getattr(self.model[0].auto_model.config, '_commit_hash', None)
+        require(bool(resolved), 'Model must have a resolved repository revision for cache versioning')
+        self.key = f'{model}@{resolved}:passages-v1'
+
+    def chunks(self, text):
+        # Offsets preserve verbatim evidence; reserve room for model special tokens.
+        tokenizer = self.model.tokenizer
+        encoded = tokenizer(text, add_special_tokens=False, return_offsets_mapping=True, truncation=False)
+        offsets = encoded['offset_mapping']
+        size = self.model.max_seq_length - tokenizer.num_special_tokens_to_add(pair=False)
+        require(size > 0, 'Invalid model token limit')
+        overlap = min(32, size // 4)
+        chunks = []
+        for start in range(0, len(offsets), size - overlap):
+            window = offsets[start:start + size]
+            if not window:
+                break
+            a, b = window[0][0], window[-1][1]
+            chunks.append({'start_char': a, 'end_char': b, 'text': text[a:b]})
+            if start + size >= len(offsets):
+                break
+        return chunks
+
+    def encode(self, texts):
+        return self.model.encode(texts, normalize_embeddings=True, show_progress_bar=False).tolist()
+
+
+def essay_text(profile):
+    text = profile.get('essay_draft')
+    require(text is None or isinstance(text, str), 'essay_draft must be text or null')
+    return text if text and text.strip() else None
+
+
+def text_hash(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def normalize(vector):
+    require(isinstance(vector, (list, tuple)) and bool(vector), 'Empty embedding')
+    require(all(type(v) in (int, float) and math.isfinite(v) for v in vector), 'Invalid embedding values')
+    norm = math.sqrt(sum(v * v for v in vector))
+    require(norm > 0, 'Zero embedding')
+    return [v / norm for v in vector]
+
+
+def embed_text(embedder, text):
+    chunks = embedder.chunks(text)
+    require(bool(chunks), 'Essay produced no passages')
+    vectors = embedder.encode([c['text'] for c in chunks])
+    require(len(vectors) == len(chunks), 'Embedding count mismatch')
+    vectors = [normalize(v) for v in vectors]
+    require(len({len(v) for v in vectors}) == 1, 'Embedding dimension mismatch')
+    return chunks, vectors
+
+
+def index_essays(db, embedder, include_synthetic=False):
+    db.executescript(INDEX_SCHEMA)
+    indexed = skipped = 0
+    rows = db.execute('''SELECT s.id, s.profile_json, src.synthetic FROM snapshots s
+        JOIN sources src ON src.id=s.source_id''').fetchall()
+    # Compute before the transaction so a model failure cannot partially update the index.
+    pending = []
+    for row in rows:
+        if row['synthetic'] and not include_synthetic:
+            continue
+        text = essay_text(json.loads(row['profile_json']))
+        if text is None:
+            skipped += 1
+            continue
+        digest = text_hash(text)
+        cached = db.execute('SELECT text_hash FROM essay_embeddings WHERE snapshot_id=? AND model_key=?',
+                            (row['id'], embedder.key)).fetchone()
+        if cached and cached['text_hash'] == digest:
+            skipped += 1
+            continue
+        chunks, vectors = embed_text(embedder, text)
+        pending.append((row['id'], embedder.key, digest, json.dumps(chunks), json.dumps(vectors)))
+    with db:
+        db.executemany('INSERT OR REPLACE INTO essay_embeddings VALUES (?, ?, ?, ?, ?)', pending)
+    indexed = len(pending)
+    return {'model': embedder.key, 'indexed': indexed, 'skipped': skipped}
+
+
+def essay_search(db, query, embedder, college_id, cycle, round_, program, residency,
+                 limit=10, include_synthetic=False, exclude_student_id=None,
+                 min_academic_coverage=0.5, min_academic_score=0.5):
+    require(limit > 0, 'limit must be positive')
+    require(0 <= min_academic_coverage <= 1 and 0 <= min_academic_score <= 1, 'Academic thresholds must be between 0 and 1')
+    text = essay_text(query)
+    require(text is not None, 'Query requires a nonempty essay_draft')
+    db.executescript(INDEX_SCHEMA)
+    # Use every comparable student, rather than just the academic top ten.
+    pool = search(db, query, college_id, cycle, round_, program, residency,
+                  limit=2147483647, include_synthetic=include_synthetic, exclude_student_id=exclude_student_id, deduplicate=False)
+    query_chunks, query_vectors = embed_text(embedder, text)
+    matches, unindexed, excluded = [], 0, 0
+    for match in pool['matches']:
+        if match['coverage'] < min_academic_coverage or match['score'] < min_academic_score:
+            excluded += 1
+            continue
+        row = db.execute('''SELECT e.*, s.profile_json FROM applications a
+            JOIN snapshots s ON s.id=a.snapshot_id
+            LEFT JOIN essay_embeddings e ON e.snapshot_id=s.id AND e.model_key=?
+            WHERE a.id=?''', (embedder.key, match['application_id'])).fetchone()
+        candidate_text = essay_text(json.loads(row['profile_json']))
+        if not candidate_text or row['text_hash'] != text_hash(candidate_text):
+            unindexed += 1
+            continue
+        comparison = compare_passages(query_chunks, query_vectors, json.loads(row['chunks_json']), json.loads(row['vectors_json']))
+        matches.append({**match, **comparison})
+    matches.sort(key=lambda m: (-m['essay_similarity'], -m['rank_score'], m['application_id']))
+    unique, seen = [], set()
+    for match in matches:
+        if match['student_id'] not in seen:
+            unique.append(match)
+            seen.add(match['student_id'])
+    return {'college_id': college_id, 'model': embedder.key, 'category': 'insufficient evidence',
+            'reason': 'Essay similarity measures content resemblance, not quality or admission probability.',
+            'eligible_students': len({m['student_id'] for m in pool['matches']}), 'unindexed_or_missing_essays': unindexed,
+            'excluded_by_academic_thresholds': excluded, 'synthetic_included': include_synthetic,
+            'matches': unique[:limit]}
+
+
+def compare_passages(query_chunks, query_vectors, chunks, vectors):
+    require(len(chunks) == len(vectors) and bool(vectors), 'Invalid cached embedding record')
+    vectors = [normalize(v) for v in vectors]
+    require(all(len(v) == len(query_vectors[0]) for v in vectors), 'Query/index embedding dimensions differ')
+    scores = [[max(-1.0, min(1.0, sum(a*b for a, b in zip(q, v)))) for v in vectors] for q in query_vectors]
+    # Symmetric mean of best passage matches: less dominated by a single shared phrase.
+    score = (sum(max(r) for r in scores) / len(scores)
+             + sum(max(r[j] for r in scores) for j in range(len(vectors))) / len(vectors)) / 2
+    best_i, best_j = max(((i, j) for i in range(len(scores)) for j in range(len(vectors))), key=lambda ij: scores[ij[0]][ij[1]])
+    return {'essay_similarity': round(score, 4), 'matching_passages': {'query': query_chunks[best_i], 'historical': chunks[best_j], 'cosine_similarity': round(scores[best_i][best_j], 4)}}
diff --git a/applicant_engine/admissions/evidence.py b/applicant_engine/admissions/evidence.py
new file mode 100644
index 0000000..43743a6
--- /dev/null
+++ b/applicant_engine/admissions/evidence.py
@@ -0,0 +1,128 @@
+"""Source-scoped outcome descriptions and ranking sensitivity, not predictions."""
+from datetime import datetime, timezone
+
+from admissions.core import require
+
+LEAN_GAP = .03
+TEXT = {'closer_to_admitted': 'Closer to the admitted examples in this evidence pool.',
+        'closer_to_denied': 'Closer to the denied examples in this evidence pool.',
+        'in_between': 'Similar distance to the admitted and denied examples.'}
+
+
+def event_time(event):
+    date = datetime.fromisoformat(event['occurred_at'])
+    return date.replace(tzinfo=timezone.utc) if date.tzinfo is None else date.astimezone(timezone.utc)
+
+
+def outcome_view(match):
+    events = match['outcome_events']
+    latest = []
+    if events:
+        last = max(event_time(e) for e in events)
+        latest = [e for e in events if event_time(e) == last]
+    decisions = {e['decision'] for e in latest}
+    decision = next(iter(decisions)) if len(decisions) == 1 else 'conflicting' if decisions else 'unknown'
+    profile_pool = match.get('evidence_pool', 'unclassified')
+    event_pools = {e.get('evidence_pool') or 'unclassified' for e in latest}
+    synthetic = match['synthetic'] or any(e['synthetic'] for e in latest)
+    if synthetic:
+        pool = 'synthetic'
+    elif not latest or event_pools == {profile_pool}:
+        pool = profile_pool
+    else:
+        pool = profile_pool + ' -> ' + '+'.join(sorted(event_pools))
+    supported = ('document_supported', 'counselor_reviewed')
+    verified = bool(latest) and not synthetic and decision != 'conflicting' and match.get('verification_level') in supported and all(e['verified'] and e.get('verification_level') in supported for e in latest)
+    return {'decision': decision, 'pool': pool, 'synthetic': bool(synthetic), 'verified': verified,
+            'profile_verification': match.get('verification_level','unverified'),
+            'outcome_verification': sorted({e.get('verification_level') or 'unverified' for e in latest}),
+            'latest_events': latest}
+
+
+def lean(gap):
+    if gap >= LEAN_GAP: return 'closer_to_admitted'
+    if gap <= -LEAN_GAP: return 'closer_to_denied'
+    return 'in_between'
+
+
+def mean(values):
+    values = list(values)
+    return sum(values)/len(values) if values else None
+
+
+def example(match, view):
+    return {'application_id': match['application_id'], 'student_id': match['student_id'],
+            'distance': round(1-match['rank_score'],4), 'coverage': match['coverage'],
+            'decision': view['decision'], 'synthetic':view['synthetic'],
+            'source':match['source'], 'components':match['components'],
+            'profile_evidence':match.get('profile_evidence',[]),
+            'matching_passages':match['matching_passages'], 'outcome_evidence':view['latest_events']}
+
+
+def outcome_comparisons(matches, neighbours=7, needed=15):
+    require(type(neighbours) is int and neighbours > 0, 'neighbours must be positive')
+    require(type(needed) is int and needed > 0, 'needed must be positive')
+    groups = {}
+    # Partition by provenance AND verification. Never borrow support across pools.
+    for match in sorted(matches,key=lambda m:(-m['rank_score'],-m['cycle'],m['application_id'])):
+        view = outcome_view(match)
+        key = (view['pool'], view['synthetic'], view['verified'], view['profile_verification'], tuple(view['outcome_verification']))
+        group = groups.setdefault(key, [])
+        if not any(m['student_id']==match['student_id'] for m,_ in group):
+            group.append((match,view))
+    pools = []
+    for key, rows in sorted(groups.items()):
+        pool, synthetic, verified, profile_verification, outcome_verification = key
+        admitted = [(m,v) for m,v in rows if v['decision']=='admit']
+        denied = [(m,v) for m,v in rows if v['decision']=='deny']
+        counts = {d:sum(v['decision']==d for _,v in rows) for d in ('admit','deny','waitlist','defer','withdraw','unknown','conflicting')}
+        a, d = admitted[:neighbours], denied[:neighbours]
+        da = mean(1-m['rank_score'] for m,_ in a)
+        dd = mean(1-m['rank_score'] for m,_ in d)
+        gap = dd-da if da is not None and dd is not None else None
+        status = 'ok' if len(admitted)>=needed and len(denied)>=needed else 'not_enough' if admitted and denied else 'none'
+        direction = lean(gap) if status=='ok' else None
+        parts = []
+        for field in sorted({k for m,_ in a+d for k in m['components']}):
+            def component_summary(near):
+                comps = [m['components'][field] for m,_ in near if field in m['components']]
+                return {'n':len(comps),'mean_similarity':mean(c['similarity'] for c in comps), 'mean_coverage':mean(c['coverage'] for c in comps)}
+            parts.append({'component':field,'admitted':component_summary(a),'denied':component_summary(d)})
+        pool_id = '|'.join((pool,'synthetic' if synthetic else 'real','verified' if verified else 'unverified',profile_verification,','.join(outcome_verification)))
+        pools.append({'pool_id':pool_id,'evidence_pool':pool,'synthetic':synthetic,'verified':verified,
+            'profile_verification':profile_verification,'outcome_verification':list(outcome_verification),
+            'status':status,'counts':counts,'n_students':len(rows),'needed_per_group':needed,'neighbours':neighbours,
+            'sources':sorted({m['source'] for m,_ in rows}),
+            'd_admitted':round(da,4) if da is not None else None,'d_denied':round(dd,4) if dd is not None else None,
+            'gap':round(gap,4) if gap is not None else None,'lean':direction,
+            'text':TEXT[direction] if direction else 'Not enough admitted and denied examples in this evidence pool to describe a direction.',
+            'nearest_admitted':[example(m,v) for m,v in a[:3]],'nearest_denied':[example(m,v) for m,v in d[:3]],
+            'parts':parts})
+    return {'neighbours':neighbours,'needed_per_group':needed,'pools':pools,
+            'distance_definition':'1 minus coverage-adjusted rank score',
+            'caveat':'These describe selected historical examples. Self-reporting, missing information, and changing admissions policies limit interpretation. Synthetic examples are demonstrations only.'}
+
+
+def stability(base_matches, base_pools, variants, top_k=10):
+    """Variants contain reranked full matches; outcomes never enter reranking."""
+    base_ids = [m['application_id'] for m in base_matches[:top_k]]
+    scenarios, flips = [], []
+    base_by_id = {p['pool_id']:p for p in base_pools['pools']}
+    for name, matches, comparison in variants:
+        ids = [m['application_id'] for m in matches[:top_k]]
+        union = set(base_ids)|set(ids)
+        by_id = {p['pool_id']:p for p in comparison['pools']}
+        changes = []
+        for pool_id in sorted(set(base_by_id)|set(by_id)):
+            before, after = base_by_id.get(pool_id), by_id.get(pool_id)
+            b = (before['status'],before['lean']) if before else ('absent',None)
+            a = (after['status'],after['lean']) if after else ('absent',None)
+            if b != a:
+                change = {'scenario':name,'pool_id':pool_id,'before':{'status':b[0],'lean':b[1]},'after':{'status':a[0],'lean':a[1]}}
+                changes.append(change); flips.append(change)
+        scenarios.append({'scenario':name,'top_ids':ids,'top_k_jaccard':round(len(set(base_ids)&set(ids))/len(union),4) if union else None,
+                          'top_order_changed':ids!=base_ids,'pool_changes':changes})
+    return {'top_k':top_k,'status':'ok' if base_ids else 'none','scenarios':scenarios,
+            'ranking_steady': all(not s['top_order_changed'] for s in scenarios) if base_ids else None,
+            'outcome_direction_steady':not flips if any(p['status']=='ok' for p in base_pools['pools']) else None,
+            'flips':flips,'caveat':'Sensitivity to these chosen perturbations does not measure accuracy or causal effects.'}
diff --git a/applicant_engine/admissions/intake.py b/applicant_engine/admissions/intake.py
new file mode 100644
index 0000000..14c0007
--- /dev/null
+++ b/applicant_engine/admissions/intake.py
@@ -0,0 +1,209 @@
+"""Evidence-backed staging for explicit intake fields and essay text."""
+import csv
+import hashlib
+import io
+import json
+import re
+from datetime import datetime, timezone
+from uuid import uuid4
+
+from admissions.core import require, validate_profile
+
+SCHEMA = '''
+CREATE TABLE IF NOT EXISTS intake_batches (
+ id TEXT PRIMARY KEY, published_snapshot_id TEXT REFERENCES snapshots(id)
+);
+CREATE TABLE IF NOT EXISTS documents (
+ id TEXT PRIMARY KEY, batch_id TEXT NOT NULL REFERENCES intake_batches(id),
+ student_id TEXT NOT NULL, kind TEXT NOT NULL, filename TEXT NOT NULL,
+ content TEXT NOT NULL, sha256 TEXT NOT NULL, synthetic INTEGER NOT NULL,
+ consent TEXT NOT NULL, created_at TEXT NOT NULL
+);
+CREATE TABLE IF NOT EXISTS document_assets (
+ document_id TEXT PRIMARY KEY REFERENCES documents(id),
+ original_bytes BLOB NOT NULL, pages_json TEXT NOT NULL
+);
+CREATE TABLE IF NOT EXISTS field_candidates (
+ id TEXT PRIMARY KEY, document_id TEXT NOT NULL REFERENCES documents(id),
+ field TEXT NOT NULL, value_json TEXT, evidence_json TEXT NOT NULL,
+ extractor_version TEXT NOT NULL, issue TEXT,
+ status TEXT NOT NULL DEFAULT 'pending', reviewer TEXT, reviewed_at TEXT
+);
+CREATE TABLE IF NOT EXISTS review_events (
+ id TEXT PRIMARY KEY, candidate_id TEXT NOT NULL REFERENCES field_candidates(id),
+ status TEXT NOT NULL, reviewer TEXT NOT NULL, reviewed_at TEXT NOT NULL
+);
+CREATE TABLE IF NOT EXISTS profile_evidence (
+ snapshot_id TEXT NOT NULL REFERENCES snapshots(id),
+ field TEXT NOT NULL, candidate_id TEXT NOT NULL REFERENCES field_candidates(id),
+ PRIMARY KEY(snapshot_id, field)
+);
+'''
+FIELDS = {'gpa', 'sat_submitted', 'rigor', 'activities', 'interests', 'essay_draft', 'activity_records', 'courses'}
+
+
+def now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def setup(db):
+    db.executescript(SCHEMA)
+
+
+def parse_value(field, raw):
+    if field in ('activity_records', 'courses'):
+        value = json.loads(raw)
+    elif field == 'gpa':
+        match = re.fullmatch(r'\s*([\d.]+)\s*/\s*([\d.]+)\s+(unweighted|weighted)\s*', raw, re.I)
+        require(match is not None, 'Expected GPA like: 3.8 / 4.0 unweighted')
+        value = {'value': float(match[1]), 'scale': float(match[2]), 'weighted': match[3].lower() == 'weighted'}
+    elif field == 'sat_submitted':
+        value = int(raw.strip())
+    elif field in ('rigor', 'activities', 'interests'):
+        value = list(dict.fromkeys(x.strip().casefold() for x in raw.split(';') if x.strip()))
+        require(bool(value), 'No tags found')
+    else:
+        value = raw
+    validate_profile({field: value})
+    return value
+
+
+def extract(content, kind):
+    if kind == 'essay':
+        require(bool(content.strip()), 'Essay is empty')
+        return [('essay_draft', content, {'start_char': 0, 'end_char': len(content), 'quoted_text': content})]
+    records = []
+    if kind == 'intake-text':
+        offset = 0
+        for line in content.splitlines(keepends=True):
+            match = re.match(r'^\s*([a-z_]+)\s*:\s*(.*?)\s*$', line)
+            if match and match[1] in FIELDS:
+                a, b = match.span(2)
+                records.append((match[1], match[2], {'start_char': offset+a, 'end_char': offset+b, 'quoted_text': content[offset+a:offset+b]}))
+            offset += len(line)
+    elif kind == 'intake-csv':
+        reader = csv.DictReader(io.StringIO(content))
+        require(reader.fieldnames is not None and len(reader.fieldnames) == len(set(reader.fieldnames)), 'CSV needs unique headers')
+        rows = list(reader)
+        require(len(rows) == 1, 'CSV must contain exactly one student row per document')
+        require(None not in rows[0], 'CSV has extra cells')
+        for field, raw in rows[0].items():
+            if field in FIELDS and raw and raw.strip():
+                records.append((field, raw, {'row': 2, 'column': field, 'quoted_text': raw}))
+    else:
+        raise ValueError('Supported kinds: intake-text, intake-csv, essay')
+    require(bool(records), 'No recognized fields found; use explicit intake field names')
+    return records
+
+
+def stage(db, content, filename, kind, student_id, synthetic, consent, batch_id=None, extracted_records=None, original_bytes=None, pages=None):
+    setup(db)
+    require(bool(student_id.strip()), 'student_id is required')
+    require(type(synthetic) is bool and consent in ('granted', 'synthetic'), 'Consent assertion is required')
+    require(synthetic or consent == 'granted', 'Real documents require granted consent')
+    require(synthetic or consent != 'synthetic', 'Synthetic consent is only for synthetic documents')
+    records = extracted_records if extracted_records is not None else extract(content, kind)
+    batch_id = batch_id or str(uuid4())
+    existing = db.execute('SELECT * FROM intake_batches WHERE id=?', (batch_id,)).fetchone()
+    if existing:
+        require(existing['published_snapshot_id'] is None, 'Published batch is immutable')
+        owners = db.execute('SELECT DISTINCT student_id, synthetic FROM documents WHERE batch_id=?', (batch_id,)).fetchall()
+        require(all(r['student_id'] == student_id and bool(r['synthetic']) == synthetic for r in owners), 'Batch cannot mix students or real/synthetic documents')
+    document_id = str(uuid4())
+    with db:
+        db.execute('INSERT OR IGNORE INTO intake_batches(id) VALUES (?)', (batch_id,))
+        db.execute('INSERT INTO documents VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)',
+                   (document_id, batch_id, student_id, kind, filename, content, hashlib.sha256(original_bytes if original_bytes is not None else content.encode()).hexdigest(), synthetic, consent, now()))
+        if original_bytes is not None:
+            db.execute('INSERT INTO document_assets VALUES (?, ?, ?)', (document_id, original_bytes, json.dumps(pages or [])))
+        for record in records:
+            field, raw, evidence = record[:3]
+            require(field in FIELDS, 'Unknown extracted field')
+            issue = record[3] if len(record) == 4 else None
+            try:
+                value = raw if extracted_records is not None else parse_value(field, raw)
+                if not issue:
+                    validate_profile({field: value})
+            except (ValueError, TypeError) as exc:
+                value, issue = None, str(exc)
+            db.execute('INSERT INTO field_candidates(id, document_id, field, value_json, evidence_json, extractor_version, issue) VALUES (?, ?, ?, ?, ?, ?, ?)',
+                       (str(uuid4()), document_id, field, json.dumps(value), json.dumps(evidence), 'document-rules-v2' if extracted_records is not None else 'explicit-fields-v1', issue))
+    return inspect_batch(db, batch_id)
+
+
+def inspect_batch(db, batch_id):
+    setup(db)
+    batch = db.execute('SELECT * FROM intake_batches WHERE id=?', (batch_id,)).fetchone()
+    require(batch is not None, 'Unknown batch')
+    rows = db.execute('''SELECT c.*, d.filename FROM field_candidates c JOIN documents d ON d.id=c.document_id
+        WHERE d.batch_id=? ORDER BY c.field, c.id''', (batch_id,)).fetchall()
+    candidates, values = [], {}
+    for row in rows:
+        item = dict(row)
+        item['value'] = json.loads(item.pop('value_json'))
+        item['evidence'] = json.loads(item.pop('evidence_json'))
+        candidates.append(item)
+        if item['status'] != 'rejected' and not item['issue']:
+            values.setdefault(item['field'], set()).add(json.dumps(item['value'], sort_keys=True))
+    documents = [dict(r) for r in db.execute('''SELECT d.id, d.filename, d.kind, a.pages_json FROM documents d
+        LEFT JOIN document_assets a ON a.document_id=d.id WHERE d.batch_id=?''', (batch_id,))]
+    for document in documents:
+        document['pages'] = json.loads(document.pop('pages_json') or '[]')
+    return {'batch_id': batch_id, 'documents': documents, 'published_snapshot_id': batch['published_snapshot_id'],
+            'conflicts': sorted(k for k, v in values.items() if len(v) > 1), 'candidates': candidates}
+
+
+def review(db, candidate_id, status, reviewer):
+    setup(db)
+    require(status in ('accepted', 'rejected'), 'Review must accept or reject')
+    require(bool(reviewer.strip()), 'Reviewer is required')
+    row = db.execute('''SELECT c.*, b.published_snapshot_id FROM field_candidates c
+        JOIN documents d ON d.id=c.document_id JOIN intake_batches b ON b.id=d.batch_id WHERE c.id=?''', (candidate_id,)).fetchone()
+    require(row is not None, 'Unknown candidate')
+    require(row['published_snapshot_id'] is None, 'Published batch is immutable')
+    require(status != 'accepted' or row['issue'] is None, 'Invalid candidate cannot be accepted; reject and stage a correction')
+    timestamp = now()
+    with db:
+        db.execute('UPDATE field_candidates SET status=?, reviewer=?, reviewed_at=? WHERE id=?', (status, reviewer, timestamp, candidate_id))
+        db.execute('INSERT INTO review_events VALUES (?, ?, ?, ?, ?)', (str(uuid4()), candidate_id, status, reviewer, timestamp))
+
+
+def publish(db, batch_id, snapshot_id, captured_at):
+    report = inspect_batch(db, batch_id)
+    require(report['published_snapshot_id'] is None, 'Batch already published')
+    datetime.fromisoformat(captured_at)
+    require(all(c['status'] != 'pending' for c in report['candidates']), 'Review every candidate before publishing')
+    require(not report['conflicts'], 'Resolve conflicting values before publishing')
+    accepted = [c for c in report['candidates'] if c['status'] == 'accepted']
+    require(bool(accepted), 'No accepted fields')
+    profile, evidence = {}, {}
+    for c in accepted:
+        profile[c['field']] = c['value']
+        evidence.setdefault(c['field'], c['id'])
+    validate_profile(profile)
+    documents = db.execute('SELECT * FROM documents WHERE batch_id=? ORDER BY id', (batch_id,)).fetchall()
+    source_id = 'intake:' + batch_id
+    with db:
+        db.execute('INSERT INTO sources VALUES (?, ?, ?, ?, ?)', (source_id, 'reviewed_intake', documents[0]['synthetic'], documents[0]['consent'], 'intake batch ' + batch_id))
+        db.execute('INSERT INTO source_metadata VALUES (?, ?, ?)', (source_id, 'unclassified', 'unverified'))
+        db.execute('INSERT OR IGNORE INTO students VALUES (?)', (documents[0]['student_id'],))
+        db.execute('INSERT INTO snapshots VALUES (?, ?, ?, ?, ?, ?)', (snapshot_id, documents[0]['student_id'], source_id, 1, captured_at, json.dumps(profile)))
+        db.executemany('INSERT INTO profile_evidence VALUES (?, ?, ?)', [(snapshot_id, f, c) for f, c in evidence.items()])
+        db.execute('UPDATE intake_batches SET published_snapshot_id=? WHERE id=?', (snapshot_id, batch_id))
+    return {'snapshot_id': snapshot_id, 'profile': profile, 'source_id': source_id}
+
+
+def stage_document(db, path, kind, student_id, synthetic, consent, batch_id=None, ocr=False):
+    from pathlib import Path
+    from admissions.documents import read_pdf, combine_pages, extract_freeform
+    path = Path(path)
+    original = path.read_bytes()
+    if kind == 'pdf':
+        pages = read_pdf(path, ocr=ocr)
+    else:
+        require(kind == 'freeform', 'Document kind must be pdf or freeform')
+        pages = [{'page': 1, 'text': original.decode('utf-8'), 'method': 'text', 'warning': None}]
+    content, page_ranges = combine_pages(pages)
+    records = extract_freeform(content, page_ranges)
+    return stage(db, content, path.name, kind, student_id, synthetic, consent, batch_id,
+                 extracted_records=records, original_bytes=original, pages=page_ranges)
diff --git a/applicant_engine/admissions/retrieval.py b/applicant_engine/admissions/retrieval.py
new file mode 100644
index 0000000..0ef65ca
--- /dev/null
+++ b/applicant_engine/admissions/retrieval.py
@@ -0,0 +1,238 @@
+"""Unified, evidence-aware retrieval; heuristic similarity, not admission prediction."""
+import json
+import math
+import re
+
+from admissions.core import require, search, similarity, validate_profile
+from admissions.essays import INDEX_SCHEMA, compare_passages, embed_text, essay_text, text_hash
+
+WEIGHTS = {'gpa': .20, 'sat_submitted': .10, 'courses': .20, 'activities': .25, 'interests': .05, 'essay': .20}
+VERSION = 'hybrid-v2'
+
+
+def overlap(a, b):
+    a = set(re.findall(r'\w+', a.casefold()))
+    b = set(re.findall(r'\w+', b.casefold()))
+    return len(a & b) / len(a | b) if a and b else 0
+
+
+def grade_similarity(a, b):
+    letters = ['F', 'D-', 'D', 'D+', 'C-', 'C', 'C+', 'B-', 'B', 'B+', 'A-', 'A', 'A+']
+    if a in letters and b in letters:
+        return max(0, 1-abs(letters.index(a)-letters.index(b))/6)
+    # Only compare numeric grades when their denominators are explicit and identical.
+    pattern = r'(\d+(?:\.\d+)?)\s*/\s*(\d+(?:\.\d+)?)'
+    aa, bb = re.fullmatch(pattern, a), re.fullmatch(pattern, b)
+    if aa and bb and float(aa[2]) == float(bb[2]) and float(aa[2]) > 0:
+        return max(0, 1-abs(float(aa[1])-float(bb[1]))/(float(aa[2])*.25))
+    return None
+
+
+def record_pair(a, b, kind):
+    # Names provide a match anchor; details cannot match unrelated records by themselves.
+    name = overlap(a['name'], b['name'])
+    if name == 0:
+        return None
+    weights = {'name': .6, 'grade': .20, 'level': .15, 'credits': .05} if kind == 'courses' else {'name': .4, 'role': .15, 'hours': .15, 'duration': .15, 'achievements': .15}
+    values = {'name': name}
+    if kind == 'courses':
+        grade = grade_similarity(a['grade'], b['grade'])
+        if grade is not None:
+            values['grade'] = grade
+        if a.get('credits') is not None and b.get('credits') is not None:
+            values['credits'] = max(0, 1-abs(a['credits']-b['credits'])/max(1, a['credits'], b['credits']))
+        if a.get('level') and b.get('level'):
+            values['level'] = float(a['level'].casefold() == b['level'].casefold())
+    else:
+        if a.get('role') and b.get('role'):
+            values['role'] = overlap(a['role'], b['role'])
+        if a.get('hours_per_week') is not None and b.get('hours_per_week') is not None:
+            values['hours'] = max(0, 1-abs(a['hours_per_week']-b['hours_per_week'])/max(5, a['hours_per_week'], b['hours_per_week']))
+        if a.get('duration') and b.get('duration'):
+            months = lambda d: d['value']*(12 if d['unit'] == 'year' else 1)
+            x, y = months(a['duration']), months(b['duration'])
+            values['duration'] = max(0, 1-abs(x-y)/max(12, x, y))
+        if a.get('achievements') and b.get('achievements'):
+            values['achievements'] = overlap(' '.join(a['achievements']), ' '.join(b['achievements']))
+    coverage = sum(weights[k] for k in values)
+    score = sum(values[k]*weights[k] for k in values)/coverage
+    return {'query_name': a['name'], 'historical_name': b['name'], 'similarity': score,
+            'coverage': coverage, 'features': values}
+
+
+def record_similarity(a, b, kind):
+    if not a or not b:
+        return None
+    pairs = []
+    for i, x in enumerate(a):
+        for j, y in enumerate(b):
+            pair = record_pair(x, y, kind)
+            if pair:
+                pairs.append((pair['similarity']*pair['coverage'], i, j, pair))
+    # Deterministic one-to-one alignment prevents reusing one activity/course repeatedly.
+    pairs.sort(key=lambda p: (-p[0], p[1], p[2]))
+    used_a, used_b, selected = set(), set(), []
+    for _, i, j, pair in pairs:
+        if i not in used_a and j not in used_b:
+            used_a.add(i); used_b.add(j); selected.append(pair)
+    size = max(len(a), len(b))
+    unmatched = size-len(selected)
+    coverage = (sum(p['coverage'] for p in selected)+unmatched)/size
+    numerator = sum(p['similarity']*p['coverage'] for p in selected)/size
+    return {'similarity': numerator/coverage if coverage else 0, 'coverage': coverage,
+            'matches': selected, 'unmatched_query': [x['name'] for i, x in enumerate(a) if i not in used_a],
+            'unmatched_historical': [x['name'] for i, x in enumerate(b) if i not in used_b]}
+
+
+def structured_components(query, candidate):
+    legacy = similarity(query, candidate)['components']
+    components = {}
+    for field in ('gpa', 'sat_submitted', 'interests'):
+        if field in legacy:
+            components[field] = {'similarity': legacy[field]['similarity'], 'coverage': 1, 'method': 'structured'}
+    for field, rich, fallback, fallback_coverage in [('courses', 'courses', 'rigor', .3), ('activities', 'activity_records', 'activities', .4)]:
+        result = record_similarity(query.get(rich), candidate.get(rich), rich)
+        if result is not None:
+            components[field] = {**result, 'method': 'record alignment'}
+        elif fallback in legacy:
+            components[field] = {'similarity': legacy[fallback]['similarity'], 'coverage': fallback_coverage, 'method': 'tag fallback'}
+    return components
+
+
+def summarize(components, weights):
+    coverage = sum(weights[k]*v['coverage'] for k, v in components.items())
+    rank = sum(weights[k]*v['coverage']*v['similarity'] for k, v in components.items())
+    return rank/coverage if coverage else 0, coverage, rank
+
+
+def retrieve(db, query, college_id, cycle, round_, program, residency, embedder=None,
+             limit=10, include_synthetic=False, exclude_student_id=None,
+             without_essays=False, min_academic_coverage=.25, min_academic_similarity=.4,
+             weights=None, diagnostics=True, neighbours=7, needed=15):
+    validate_profile(query)
+    require(type(neighbours) is int and neighbours > 0, 'neighbours must be positive')
+    require(type(needed) is int and needed > 0, 'needed must be positive')
+    if diagnostics and embedder is not None:
+        embedder = CachedEmbedder(embedder)
+    require(type(limit) is int and limit > 0, 'limit must be positive')
+    require(0 <= min_academic_coverage <= 1 and 0 <= min_academic_similarity <= 1, 'Thresholds must be between 0 and 1')
+    weights = dict(WEIGHTS if weights is None else weights)
+    require(set(weights) == set(WEIGHTS) and all(type(v) in (int,float) and math.isfinite(v) and v > 0 for v in weights.values()), 'Weights must contain all components with positive finite values')
+    total = sum(weights.values()); weights = {k:v/total for k,v in weights.items()}
+    query_text = essay_text(query)
+    if query_text and not without_essays:
+        require(embedder is not None, 'Essay retrieval requires an embedding model; use explicit without_essays mode to disable it')
+        db.executescript(INDEX_SCHEMA)
+        query_chunks, query_vectors = embed_text(embedder, query_text)
+    else:
+        query_chunks = query_vectors = None
+    pool = search(db, query, college_id, cycle, round_, program, residency, limit=2147483647,
+                  include_synthetic=include_synthetic, exclude_student_id=exclude_student_id,
+                  deduplicate=False, include_unscored=True)
+    matches, excluded, warnings = [], 0, []
+    has_field_evidence = db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='profile_evidence'").fetchone() is not None
+    if without_essays:
+        warnings.append('Essay scoring explicitly disabled')
+    elif not query_text:
+        warnings.append('Query has no essay; essay evidence unavailable')
+    academic_weights = {k: weights[k] for k in ('gpa','sat_submitted','courses')}
+    academic_total = sum(academic_weights.values())
+    for match in pool['matches']:
+        row = db.execute('''SELECT s.id, s.profile_json FROM applications a JOIN snapshots s ON s.id=a.snapshot_id WHERE a.id=?''', (match['application_id'],)).fetchone()
+        candidate = json.loads(row['profile_json'])
+        validate_profile(candidate)
+        components = structured_components(query, candidate)
+        academic = {k:v for k,v in components.items() if k in academic_weights}
+        academic_score, academic_cov, _ = summarize(academic, academic_weights)
+        academic_cov /= academic_total
+        if academic_cov < min_academic_coverage or academic_score < min_academic_similarity:
+            excluded += 1
+            continue
+        comparison = None
+        essay_status = 'disabled' if without_essays else 'query_missing'
+        if query_vectors is not None:
+            candidate_text = essay_text(candidate)
+            essay_status = 'historical_missing'
+            if candidate_text:
+                cached = db.execute('SELECT * FROM essay_embeddings WHERE snapshot_id=? AND model_key=?', (row['id'],embedder.key)).fetchone()
+                require(cached is not None and cached['text_hash'] == text_hash(candidate_text),
+                        f"Essay index missing or stale for snapshot {row['id']}; run index-essays with the same model/revision")
+                comparison = compare_passages(query_chunks, query_vectors, json.loads(cached['chunks_json']), json.loads(cached['vectors_json']))
+                components['essay'] = {'similarity': max(0, comparison['essay_similarity']), 'coverage': 1, 'method': 'passage embeddings'}
+                essay_status = 'scored'
+        score, coverage, rank = summarize(components, weights)
+        for key, component in components.items():
+            component['weight'] = weights[key]
+            component['contribution'] = round(weights[key]*component['coverage']*component['similarity'],6)
+        provenance = []
+        if has_field_evidence:
+            provenance = [dict(e) for e in db.execute('''SELECT p.field, c.document_id, d.filename, c.reviewer, c.evidence_json
+                FROM profile_evidence p JOIN field_candidates c ON c.id=p.candidate_id
+                JOIN documents d ON d.id=c.document_id WHERE p.snapshot_id=?''', (row['id'],))]
+            for item in provenance:
+                item['evidence'] = json.loads(item.pop('evidence_json'))
+        matches.append({'application_id': match['application_id'], 'student_id': match['student_id'],
+            'cycle': match['cycle'], 'synthetic': match['synthetic'], 'source': match['source'],
+            'source_id':match['source_id'], 'evidence_pool':match['evidence_pool'], 'verification_level':match['verification_level'],
+            'similarity': round(score,4), 'coverage': round(coverage,4), 'rank_score': round(rank,4),
+            'academic_similarity': round(academic_score,4), 'academic_coverage': round(academic_cov,4),
+            'components': components, 'missing_components': sorted(set(weights)-set(components)),
+            'essay_status': essay_status, 'matching_passages': comparison['matching_passages'] if comparison else None,
+            'profile_evidence': provenance, 'outcome_events': match['outcome_events']})
+    matches.sort(key=lambda m:(-m['rank_score'],-m['coverage'],-m['cycle'],m['application_id']))
+    unique, seen = [], set()
+    for match in matches:
+        if match['student_id'] not in seen:
+            unique.append(match); seen.add(match['student_id'])
+    result = {'retrieval_version': VERSION, 'model': embedder.key if query_vectors is not None else None,
+            'college_id':college_id,'weights':weights,'warnings':warnings,
+            'eligible_students': len({m['student_id'] for m in pool['matches']}),
+            'excluded_applications_by_academic_gate':excluded, 'matched_students':len(unique),
+            'synthetic_included':include_synthetic, 'category':'insufficient evidence',
+            'reason':'Combined similarity is a retrieval heuristic, not an admission probability.',
+            'matches':unique[:limit]}
+
+    from admissions.evidence import outcome_comparisons, stability
+    result['outcome_comparison'] = outcome_comparisons(matches, neighbours, needed)
+    result['stability'] = None
+    if diagnostics:
+        variants = []
+        # Neighbour-size tests reuse the ranked evidence and require no model call.
+        for k in (5, 10):
+            if k != neighbours:
+                variants.append((f'{k} neighbours', unique, outcome_comparisons(matches, k, needed)))
+        options = []
+        if query.get('sat_submitted') is not None:
+            for delta in (-30, 30):
+                changed = dict(query, sat_submitted=max(400,min(1600,query['sat_submitted']+delta)))
+                if changed['sat_submitted'] != query['sat_submitted']:
+                    options.append((f'SAT {delta:+d}', changed, weights, without_essays))
+        if query_vectors is not None:
+            for factor in (.8, 1.2):
+                changed_weights = dict(weights, essay=weights['essay']*factor)
+                options.append((f'essay weight x{factor}',query,changed_weights,False))
+            options.append(('essay excluded',query,weights,True))
+        for name, changed_query, changed_weights, disable_essays in options:
+            changed = retrieve(db, changed_query, college_id, cycle, round_, program, residency,
+                embedder=embedder,limit=max(limit,len(matches),1),include_synthetic=include_synthetic,
+                exclude_student_id=exclude_student_id,without_essays=disable_essays,
+                min_academic_coverage=min_academic_coverage,min_academic_similarity=min_academic_similarity,
+                weights=changed_weights,diagnostics=False,neighbours=neighbours,needed=needed)
+            variants.append((name,changed['matches'],changed['outcome_comparison']))
+        result['stability'] = stability(unique,result['outcome_comparison'],variants,top_k=limit)
+    return result
+
+
+class CachedEmbedder:
+    """Per-request memoization avoids repeated inference in sensitivity checks."""
+    def __init__(self, delegate):
+        self.delegate = delegate
+        self.key = delegate.key
+        self.cache = {}
+    def chunks(self, text):
+        return self.delegate.chunks(text)
+    def encode(self, texts):
+        key = tuple(texts)
+        if key not in self.cache:
+            self.cache[key] = self.delegate.encode(texts)
+        return self.cache[key]
diff --git a/applicant_engine/docs/HACK_REUSE_REVIEW.md b/applicant_engine/docs/HACK_REUSE_REVIEW.md
new file mode 100644
index 0000000..2afeb38
--- /dev/null
+++ b/applicant_engine/docs/HACK_REUSE_REVIEW.md
@@ -0,0 +1,31 @@
+# Review of Desktop/10-10-hack
+
+Reviewed requirements, contract, README, similarity/case loaders, essay reader, and spreadsheet ingestion on 2026-10-10. No source-repository files were changed. Tests ran in a temporary copy: 48 similarity/case tests passed; 60/60 acceptance labels matched and the associated whole-system checks passed.
+
+## Requirements relevant to this project
+
+The Counselor Copilot contract requires deterministic numbers and labels, traceable source evidence, separate national self-reported and counselor-owned pools, explicit insufficient-data states, list balancing, and statements grounded in retrieved cases and published college information. Its added Closeness requirements compare nearest admitted and denied applicants separately and describe stability and admitted-profile archetypes. That repository requires a standard-library-only implementation and explicitly excludes embeddings from Closeness. Those constraints govern its implementation; they do not override the user's authorized semantic retrieval design in nerd_apply.
+
+## Highest-value adaptations
+
+1. **Outcome-group evidence:** adapt `similarity._gap`, `_pool`, and `_parts_summary`. Rank using our unified features, then partition eligible records by outcome to show the nearest admitted and denied examples and per-component comparisons. Preserve waitlist/defer/unknown states rather than infer a final outcome. The source compares seven nearest records per group and requires 15 scored cases in each group before displaying a lean; both settings are provisional rather than validated sufficiency guarantees.
+2. **Stability diagnostics:** adapt `_steady`. Recompute with different neighborhood sizes and small score perturbations. For our system also vary component weights and remove the essay signal to report top-k overlap and direction changes. Record perturbations; do not describe them as forecast accuracy.
+3. **Separate evidence pools:** adapt `cases.find_similar`'s output architecture. Add explicit source pool, verification, and synthetic status to our sources; return independent cohorts/counts/summaries. A synthetic school record cannot become real verified evidence just because the source pool is counselor-owned.
+4. **Explicit cohort relaxation:** adapt `cases._steps` as a policy pattern, not its exact hook-based rules. Broaden major groups or academic thresholds only under declared configuration, label the relaxed criteria, and retain a strict result alongside any expanded result. Never invent missing application cycles, rounds, residency, or programs, or choose relaxation to produce a preferred outcome.
+5. **Taxonomy and normalization:** adapt `cases.major_group_for`, college alias mapping, ACT concordance helpers, and spreadsheet column normalization. Keep original values and mapping provenance; preserve test submission distinctions and ambiguity. Counselor activities ratings are not directly interchangeable with national self-ratings.
+6. **Essay evidence checks:** adapt `reader.quote_in_essay` / `check_notes` and privacy masking if we add LLM extraction/notes. Exact quote presence establishes textual support, not the truth of a claim or the correctness of its interpretation. Independent model agreement is not verification. Keep original-to-redacted offset mappings.
+7. **Optional archetypes:** adapt `_kinds`'s seeded k-medoids concept, naming groups from measured features and using actual profiles as medoids. Evaluate after retrieval relevance is demonstrated; a capped quadratic distance matrix is only appropriate for a small pool.
+
+## Data and implementation limits
+
+The national CSV has 2,247 applicant rows, 20,966 decision rows, and 58 college names. It has SAT/ACT, major, rank, residency, hooks, and self-rated EC-AWARDS/ESSAY-LOR-INTERVIEW. It does not have transcript/GPA records, activity descriptions, essay text, decision dates, application rounds, program-specific applications, or admissions-cycle metadata in these CSVs. Therefore it cannot validate essay embeddings and cannot directly satisfy our strict historical cohort filters. Do not fabricate absent fields or treat the combined essay/LOR/interview rating as essay text or quality.
+
+The README says the upstream public-post dataset has no stated license. This review does not establish redistribution rights or consent for importing those rows into the current consent-gated production-style schema. A separately labeled research dataset requires a provenance/use policy first; no data was imported here.
+
+`similarity._gpa` rescales GPA linearly to 4.0 without preserving grading-system weighting; retain our stricter scale/weighting compatibility instead. `cases._national` collapses repeated student/college outcomes using admitted > denied > waitlisted, potentially conflating programs with chronological decisions; retain our application/outcome-event model. Hook status and race-linked categories should not be copied as default ranking features. Counterfactual score/rating changes demonstrate changes in a distance formula, not causal admissions advice.
+
+`similarity --check` is explicitly a placeholder that prints "--check is not built yet." The requirements propose a 400-decision held-out check, but it has not been implemented. Acceptance tests validate handwritten label rules and workflow conditions, not admission forecasting or semantic retrieval relevance. Our real embedding model execution remains unverified.
+
+## Recommended next implementation
+
+Keep the unified ranker and provenance schema. Add source-scoped admitted/denied evidence summaries with explicit uncertainty states, then ranking stability diagnostics and a counselor-reviewed retrieval evaluation set. Add normalization/taxonomy and configurable cohort expansion afterward. Do not replace semantic essay retrieval with the hackathon's test-heavy distance or import its dataset as fabricated fully specified applications.
